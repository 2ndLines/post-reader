{
  "$schema": "https://unpkg.com/knip@6.48.0/schema.json",
  "ignoreBinaries": ["locale"],
  "workspaces": {
    ".": {
      "project": []
    },
    "packages/tooling": {
      "entry": ["example/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "tools/ci-checks": {
      "entry": ["src/cli/*.ts", "src/**/*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
