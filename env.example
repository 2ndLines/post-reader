# 本地开发环境变量示例（仅限本地，不是任何真实环境的凭据）。复制为 .env.local 后按需修改；.env* 不入库。
# 与 docker-compose.yml 中的本地账号一致。

DATABASE_URL=postgres://reader:reader-local-only@127.0.0.1:5432/reader
REDIS_URL=redis://127.0.0.1:6379

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=reader-local-access
S3_SECRET_ACCESS_KEY=reader-local-only-secret
BUCKET_AUDIO_PUBLIC=reader-audio-public
BUCKET_AUDIO_PRIVATE=reader-audio-private
BUCKET_SAMPLES=reader-samples
BUCKET_CONFIG=reader-config
BUCKET_TESTBENCH_ARTIFACTS=testbench-artifacts

SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# 可选：docker compose --profile tracing up 后可用
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
