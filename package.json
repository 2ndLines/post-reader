{
  "name": "post-reader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "lefthook install",
    "verify": "turbo run verify",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "knip": "knip",
    "check:licenses": "node tools/ci-checks/src/cli/licenses.ts",
    "check:pins": "node tools/ci-checks/src/cli/action-pins.ts",
    "check:versions": "node tools/ci-checks/src/cli/tool-versions.ts",
    "check:codeowners": "node tools/ci-checks/src/cli/codeowners.ts",
    "check:links": "node tools/ci-checks/src/cli/links.ts",
    "dev": "docker compose up -d --wait postgres valkey s3 mailpit && docker compose run --rm s3-init",
    "dev:down": "docker compose down",
    "spec:vectors": "pnpm --filter @post-reader/canonical-spec test && python3 -I packages/canonical-spec/scripts/expected_hash.py",
    "contracts:gen": "node packages/contracts/scripts/gen-openapi.ts",
    "contracts:check": "node packages/contracts/scripts/gen-openapi.ts --check",
    "check:config": "node packages/config-schema/scripts/check-config.ts",
    "test:int": "turbo run test:int",
    "db:migrate:new": "pnpm --filter @post-reader/server db:migrate:new",
    "check:migrations": "node tools/ci-checks/src/cli/migrations.ts",
    "check:sig-vectors": "python3 -I packages/contracts/scripts/request_signature_vectors.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.13"
  }
}
