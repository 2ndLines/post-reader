{
  "name": "post-reader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "lefthook install",
    "verify": "turbo run verify",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "knip": "knip",
    "check:licenses": "node tools/ci-checks/src/cli/licenses.ts",
    "check:pins": "node tools/ci-checks/src/cli/action-pins.ts",
    "check:versions": "node tools/ci-checks/src/cli/tool-versions.ts",
    "check:codeowners": "node tools/ci-checks/src/cli/codeowners.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.13"
  }
}
